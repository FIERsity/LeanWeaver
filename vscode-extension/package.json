{
  "name": "leanweaver",
  "displayName": "LeanWeaver",
  "description": "纯规则、零 LLM 的 Lean 4 报错解释 —— 悬停报错即看中文解释。Rule-based Lean 4 error explainer: hover errors to get clear explanations.",
  "version": "0.5.6",
  "publisher": "fiersity",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Formal Languages"
  ],
  "keywords": [
    "lean",
    "lean4",
    "theorem-proving",
    "formal-math",
    "error-explainer"
  ],
  "activationEvents": [
    "onLanguage:lean",
    "onStartupFinished",
    "onCommand:leanweaver.installLean",
    "onCommand:leanweaver.diagnose"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leanweaver.installLean",
        "title": "LeanWeaver: 安装官方 Lean 扩展 / Install official Lean extension"
      },
      {
        "command": "leanweaver.openSettings",
        "title": "LeanWeaver: 打开设置 / Open settings"
      },
      {
        "command": "leanweaver.diagnose",
        "title": "LeanWeaver: 环境诊断 / Diagnose environment"
      }
    ],
    "configuration": {
      "title": "LeanWeaver",
      "properties": {
        "leanweaver.leanweaverCli": {
          "type": "string",
          "default": "",
          "description": "Command to invoke leanweaver. Empty = auto-detect (project venv, then python3)."
        },
        "leanweaver.lang": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "default": "zh",
          "description": "Explanation language (zh=Chinese, en=English)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "test": "tsc -p ./ && node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^2.24.0",
    "mocha": "^10.4.0",
    "@types/mocha": "^10.0.6"
  }
}