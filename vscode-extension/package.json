{
  "name": "leanweaver",
  "displayName": "LeanWeaver",
  "description": "Rule-based Lean 4 error explainer — hover errors to get clear explanations. 纯规则 Lean 报错解释：悬停即懂，英语优先，中英可切。",
  "version": "1.0.0",
  "publisher": "fiersity",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/FIERsity/LeanWeaver.git"
  },
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#F5F5F5",
    "theme": "light"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "lean",
    "lean4",
    "theorem-proving",
    "formal-math",
    "error-explainer"
  ],
  "activationEvents": [
    "onLanguage:lean4",
    "onLanguage:lean",
    "onStartupFinished",
    "onCommand:leanweaver.setup"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "leanweaver.setup",
        "title": "LeanWeaver: Setup / 安装引导",
        "icon": "$(tools)"
      },
      {
        "command": "leanweaver.openSettings",
        "title": "LeanWeaver: Settings / 设置"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "leanweaver.setup"
        },
        {
          "command": "leanweaver.openSettings"
        }
      ]
    },
    "configuration": {
      "title": "LeanWeaver",
      "properties": {
        "leanweaver.lang": {
          "type": "string",
          "enum": [
            "en",
            "zh"
          ],
          "default": "en",
          "description": "Explanation language (en default / zh 中文)."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --no-dependencies",
    "test": "tsc -p ./ && node ./dist/test/runTest.js"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^2.24.0",
    "mocha": "^10.4.0",
    "typescript": "^5.4.0"
  }
}
